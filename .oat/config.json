{
  "version": 1,
  "projects": {
    "root": ".oat/projects/shared",
    "defaultScope": "shared"
  },
  "git": {
    "defaultBranch": "main"
  },
  "archive": {
    "s3Uri": "s3://tkstang-open-agent-toolkit/repositories",
    "s3SyncOnComplete": true,
    "summaryExportPath": ".oat/repo/reference/project-summaries",
    "awsProfile": "tkstang-artifact-sync",
    "awsRegion": "us-east-1"
  },
  "tools": {
    "core": true,
    "ideas": true,
    "docs": true,
    "workflows": true,
    "utility": true,
    "project-management": true,
    "research": true,
    "brainstorm": true
  },
  "localPaths": [
    ".oat/**/analysis",
    ".oat/**/pr",
    ".oat/**/reviews/archived",
    ".oat/ideas",
    ".oat/projects/**/pr",
    ".oat/projects/**/reviews/archived",
    ".oat/projects/archived",
    ".oat/projects/local"
  ],
  "workflow": {
    "archiveOnComplete": true,
    "postImplementSequence": "pr",
    "autoReviewAtHillCheckpoints": true
  },
  "instructions": {
    "claude": {
      "shims": "none"
    }
  },
  "documentation": {
    "root": "docs",
    "tooling": "markdown",
    "index": "docs/index.md",
    "ia": {
      "preset": "flat-small",
      "decision": ".oat/repo/reference/decisions/DR-261025-documentation-information.md",
      "tracks": [
        {
          "path": "docs",
          "principle": "Flat pages; the root index groups Contents by page type: Concepts, Getting started, Reference, and Operations"
        }
      ],
      "verification": "none"
    }
  },
  "pjm": {
    "initialized": true,
    "schemaVersion": 1
  }
}
